# Telegram Bot configuration
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Web application URL exposed to Telegram WebApp (e.g. ngrok or reverse proxy in production)
# In local development or standalone browser testing, this can default to http://localhost:8080
WEB_APP_URL=http://localhost:8080

# Port for Fastify API and static frontend server
PORT=8080
HOST=0.0.0.0

# Mock Mode: when true, generates synthetic incidents, services, and latency spikes
# It also allows the WebApp to authenticate with mock test data.
MOCK_MODE=true

# Optional live Sentinel daemon bridge URL (e.g. http://localhost:9090)
SENTINEL_ENDPOINT=http://localhost:9090

# Optional CanaryMesh engine URL (e.g. http://localhost:8000)
CANARYMESH_ENDPOINT=http://localhost:8000

# Comma-separated list of numeric Telegram User IDs authorized to trigger runbooks
# Leave empty to allow any user with access in MOCK_MODE
ALLOWED_TELEGRAM_USERS=

# SQLite database file path
DATABASE_PATH=./data/sentinel_pocket.db
